local fly,a,b=false,false,false
local bv,bg

local function stop()
 fly,a,b=false,false,false
 if bv then
  bv:Destroy()
  bv=nil
 end
 if bg then
  bg:Destroy()
  bg=nil
 end
 flight.Text="FLIGHT:OFF"
 up.Visible=false
 down.Visible=false
end

local function start()
 stop()
 local c=pl.Character
 local r=c and c:FindFirstChild("HumanoidRootPart")
 if not r then return end
 fly=true
 flight.Text="FLIGHT:ON"
 up.Visible=true
 down.Visible=true
 bv=Instance.new("BodyVelocity")
 bv.MaxForce=Vector3.new(1e6,1e6,1e6)
 bv.P=12500
 bv.Parent=r
 bg=Instance.new("BodyGyro")
 bg.MaxTorque=Vector3.new(1e6,1e6,1e6)
 bg.P=9000
 bg.CFrame=r.CFrame
 bg.Parent=r
end

flight.MouseButton1Click:Connect(function()
 if fly then
  stop()
 else
  start()
 end
end)

up.MouseButton1Down:Connect(function() a=true end)
up.MouseButton1Up:Connect(function() a=false end)
down.MouseButton1Down:Connect(function() b=true end)
down.MouseButton1Up:Connect(function() b=false end)close.MouseButton1Click:Connect(function()
 f.Visible=false
 open.Visible=true
end)

open.MouseButton1Click:Connect(function()
 f.Visible=true
 open.Visible=false
end)

local conn=R.Heartbeat:Connect(function()
 local c=pl.Character

 if ncOn and c then
  for _,q in ipairs(c:GetDescendants()) do
   if q:IsA("BasePart") then
    if sv[q]==nil then
     sv[q]=q.CanCollide
    end
    q.CanCollide=false
   end
  end
 end

 local r=c and c:FindFirstChild("HumanoidRootPart")
 local v=r and r.AssemblyLinearVelocity
 speed.Text=v and string.format(
  "Speed:%.1f",
  Vector3.new(v.X,0,v.Z).Magnitude
 ) or "Speed:0"

 if not fly or not bv or not bg then return end
 if not r then
  stop()
  return
 end

 local h=c:FindFirstChildOfClass("Humanoid")
 if not h then
  stop()
  return
 end

 local m=h.MoveDirection
 bv.Velocity=Vector3.new(
  m.X*fs,
  ((a and 1 or 0)-(b and 1 or 0))*45,
  m.Z*fs
 )

 local cam=workspace.CurrentCamera
 if cam then
  bg.CFrame=CFrame.lookAt(
   r.Position,
   r.Position+cam.CFrame.LookVector
  )
 end
end)

pl.CharacterAdded:Connect(function()
 stop()
 sn(false)
end)

gui.Destroying:Connect(function()
 stop()
 sn(false)
 conn:Disconnect()
end)
