local function add(c,n,parent,t)
 local o=Instance.new(c)
 o.Name=n
 for k,v in pairs(t) do o[k]=v end
 o.Parent=parent
 return o
end
local function corner(o,r)
 Instance.new("UICorner",o).CornerRadius=UDim.new(0,r or 7)
end

