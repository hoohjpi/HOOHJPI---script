local function addActivity(message)
    local entry = Instance.new("TextLabel")
    entry.Name = "ActivityEntry"
    entry.Size = UDim2.new(1, -4, 0, 0)
    entry.AutomaticSize = Enum.AutomaticSize.Y
    entry.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    entry.BorderSizePixel = 1
    entry.BorderColor3 = GOLD
    entry.Text = "[" .. os.date("%H:%M:%S") .. "] "
        .. tostring(message)
    entry.TextColor3 = GOLD_TEXT
    entry.Font = Enum.Font.SourceSans
    entry.TextSize = 11
    entry.TextWrapped = true
    entry.TextXAlignment = Enum.TextXAlignment.Left
    entry.TextYAlignment = Enum.TextYAlignment.Top
    entry.Parent = activityList

    table.insert(activityLogEntries, entry)

    while #activityLogEntries > MAX_ACTIVITY_LOG do
        local oldest = table.remove(activityLogEntries, 1)
        if oldest then
            oldest:Destroy()
        end
    end

    -- Auto Scroll to Bottom
task.defer(function()
    if activityList.Parent then
        local contentHeight = activityList.AbsoluteCanvasSize.Y
        local visibleHeight = activityList.AbsoluteSize.Y

        activityList.CanvasPosition = Vector2.new(
            0,
            math.max(0, contentHeight - visibleHeight)
        )
    end
  end)
end

