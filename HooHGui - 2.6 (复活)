local savedPlayers = {}
local storageMode = "unavailable"

local sharedEnvironment = _G
if type(getgenv) == "function" then
    local ok, environment = pcall(getgenv)
    if ok and type(environment) == "table" then
        sharedEnvironment = environment
    end
end
local function setSaveStatus(message)
    saveStatusLabel.Text = message or ""
end
local function hasFileStorage()
    return type(readfile) == "function"
        and type(writefile) == "function"
end
local function saveData()
    local okEncode, encoded = pcall(function()
        return HttpService:JSONEncode(savedPlayers)
    end)

    if not okEncode then
        storageMode = "unavailable"
        setSaveStatus("Save failed: JSON encode error")
        return false
    end

    if hasFileStorage() then
        local okWrite = pcall(function()
            writefile(SAVE_FILE, encoded)
        end)
        if okWrite then
            storageMode = "file"
            sharedEnvironment.HooHGuiSavedPlayers = savedPlayers
            setSaveStatus("Saved locally")
            return true
        end
    end

    -- Session-memory fallback only. This is not cross-session persistence.
    sharedEnvironment.HooHGuiSavedPlayers = savedPlayers
    storageMode = "memory"
    setSaveStatus("File storage unavailable: session-only")
    return false
end
local function loadData()
    local loaded = nil
    if hasFileStorage() then
        local fileExists = true
        if type(isfile) == "function" then
            local okExists, exists = pcall(isfile, SAVE_FILE)
            fileExists = okExists and exists == true
        end
        if fileExists then
            local okRead, contents = pcall(readfile, SAVE_FILE)
            if okRead and type(contents) == "string" and contents ~= "" then
                local okDecode, decoded = pcall(function()
                    return HttpService:JSONDecode(contents)
                end)
                if okDecode and type(decoded) == "table" then
                    loaded = decoded
                    storageMode = "file"
                end
            end
        else
            -- The file does not exist yet; do not report it as loaded.
            storageMode = "unavailable"
        end
    end
    if type(loaded) ~= "table"
        and type(sharedEnvironment.HooHGuiSavedPlayers) == "table" then
        loaded = sharedEnvironment.HooHGuiSavedPlayers
        if storageMode ~= "file" then
            storageMode = "memory"
        end
    end
    if type(loaded) == "table" then
        local now = os.time()
        local seenIds = {}
        local seenNames = {}
        for _, record in ipairs(loaded) do
            if type(record) == "table"
                and type(record.Username) == "string"
                and type(record.SavedAt) == "number" then
                local age = now - record.SavedAt
                local usernameKey = string.lower(record.Username)
                local userId = tonumber(record.UserId)
                local idKey = userId and tostring(userId) or nil

                local notExpired = age >= 0 and age < SAVE_TTL
                local notDuplicate = not seenNames[usernameKey]
                    and (not idKey or not seenIds[idKey])
                if notExpired and notDuplicate
                    and #savedPlayers < MAX_SAVED_PLAYERS then
                    table.insert(savedPlayers, {
                        UserId = userId,
                        Username = record.Username,
                        DisplayName = tostring(record.DisplayName or record.Username),
                        SavedAt = record.SavedAt
                    })
                    seenNames[usernameKey] = true
                    if idKey then
                        seenIds[idKey] = true
                    end
                end
            end
        end
    end
    sharedEnvironment.HooHGuiSavedPlayers = savedPlayers
    if storageMode == "file" then
        setSaveStatus("Local save ready")
    elseif storageMode == "memory" then
        setSaveStatus("Session-only storage")
    elseif hasFileStorage() then
        setSaveStatus("No saved file yet")
    else
        setSaveStatus("No compatible file storage detected")
    end
end
local function findSavedPlayer(target)
    local lowerName = string.lower(target.Name)
    for index, record in ipairs(savedPlayers) do
        if (record.UserId and record.UserId == target.UserId)
            or string.lower(record.Username) == lowerName then
            return index, record
        end
    end
    return nil, nil
end
local function copyText(text)
    local clipboardFunction = nil

    if type(setclipboard) == "function" then
        clipboardFunction = setclipboard
    elseif type(toclipboard) == "function" then
        clipboardFunction = toclipboard
    elseif type(writeclipboard) == "function" then
        clipboardFunction = writeclipboard
    end
    if clipboardFunction then
        local ok = pcall(clipboardFunction, text)
        if ok then
            manualCopyBox.Visible = false
            saveStatusLabel.Visible = true
            setSaveStatus("Copied: " .. text)
            return true
        end
    end
    -- Manual-copy fallback for environments without a clipboard function.
    manualCopyBox.Text = text
    manualCopyBox.Visible = true
    saveStatusLabel.Visible = false
    pcall(function()
        manualCopyBox:CaptureFocus()
        manualCopyBox.SelectionStart = 1
        manualCopyBox.CursorPosition = #text + 1
    end)
    return false
end
local function clearSavedRows()
    for _, child in ipairs(savedList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
